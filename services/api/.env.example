# Environment
NODE_ENV=production
PORT=3000
WEB_APP_URL=https://wondertales.art
CORS_ALLOWED_ORIGINS=https://wondertales.art,https://www.wondertales.art

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wondertales_prod
POSTGRES_USER=wondertales
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=wondertales_prod

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d
SESSION_EXPIRES_IN=30d
ENCRYPTION_KEY=64-character-hex-string-for-oauth-token-encryption

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://wondertales.art/api/v1/auth/google/callback
GOOGLE_IOS_CLIENT_ID=your-ios-client-id
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id

# Apple OAuth
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----
APPLE_CALLBACK_URL=https://wondertales.art/api/v1/auth/apple/callback

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
OPENAI_API_KEY=your-openai-api-key
# xAI text-to-speech (Grok). Falls back to XAI_API_KEY if unset (matches xAI docs naming).
GROK_API_KEY=
# XAI_API_KEY=

# Default TTS vendor for singleton getAudioProvider(): elevenlabs | google | openai | grok
# AUDIO_PROVIDER=elevenlabs
# Seed multiple voice catalogs in one run (comma-separated):
# SEED_VOICE_PROVIDERS=grok,google

# Google Cloud (for Image Generation & Quotas)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_CREDENTIALS=/path/to/service-account.json

# AI Configuration
AI_TEXT_VENDOR=gemini
# Optional: text vendor for Director only (structured visuals). When unset, uses AI_TEXT_VENDOR.
# Example: keep story text on Gemini, Director on OpenAI — AI_TEXT_VENDOR=gemini AI_DIRECTOR_TEXT_VENDOR=openai
# AI_DIRECTOR_TEXT_VENDOR=openai
# Optional: OpenAI model for Director when AI_DIRECTOR_TEXT_VENDOR=openai (defaults to OPENAI_TEXT_MODEL)
# AI_DIRECTOR_OPENAI_MODEL=gpt-5.2
AI_IMAGE_VENDOR=gemini
AI_TTS_VENDOR=elevenlabs
AI_ALIGNMENT_VENDOR=elevenlabs
GEMINI_VISION_MODEL=gemini-2.5-flash
AI_MODEL_VERSION=gemini-3-flash-preview
# Optional: overrides AI_MODEL_VERSION for Gemini structured text (Director, validation, analysis when using this provider)
# Examples: gemini-2.5-flash | gemini-3-flash-preview | gemini-3.1-flash-lite-preview | gemini-3.1-pro-preview
# GEMINI_TEXT_MODEL=gemini-3-flash-preview
# Deferred TTS prosody (structured taggedText). Default gemini-2.5-flash avoids Gemini 3 MAX_TOKENS on long stories.
# GEMINI_TTS_PROSODY_MODEL=gemini-2.5-flash

# Image Generation
SKIP_IMAGE_GENERATION=false
IMAGE_PROVIDER=nanobananapro
# Env reference images, IMAGE_PROVIDER=gemini, LLM text-only turnaround (Imagen removed)
# GEMINI_FLASH_IMAGE_MODEL=gemini-2.5-flash-image
ENABLE_IMAGE_VALIDATION=false
# Penalty applied when the validator's characterKind disagrees with the expected roster kind.
IMAGE_SCORE_PENALTY_KIND_MISMATCH=45
ENABLE_TURNAROUND_SHEET=false

# Storage (optional - for AWS S3)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_CDN_URL=

# Feature Flags
ENABLE_CHARACTER_ANALYSIS=true
USE_DIRECTOR_FLOW=false
# Log entire Director LLM prompt to app.log (msg: "Director full prompt", field fullPrompt) — very large lines
LOG_DIRECTOR_FULL_PROMPT=false

# Skip environment reference image when only one scene has images (cost optimization)
SKIP_ENV_IMAGE_FOR_SINGLE_SCENE=true

# Stripe (optional — set when ENABLE_REAL_PAYMENTS / billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Plan subscriptions: slug:price_id comma-separated (e.g. silver:price_xxx,golden:price_yyy)
# STRIPE_PRICE_IDS=
# One-time story bundles: bundleSlug:planSlug:price_id (comma-separated). Overrides DB stripe_price_id if set.
# STRIPE_BUNDLE_PRICE_IDS=bundle_small:free:price_xxx,bundle_boost_10:free:price_xxx,bundle_medium:silver:price_yyy,...
