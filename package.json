{
  "name": "wondertales",
  "version": "1.0.0",
  "private": true,
  "description": "Personalized illustrated fairy tales with AI-powered storytelling and premium narration",
  "author": "",
  "license": "ISC",
  "scripts": {
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:prod": "docker compose -f docker-compose.prod.yml up",
    "api:script": "docker compose -f docker-compose.dev.yml run --rm --entrypoint=\"\" api",
    "compare:image-validation": "cd services/api && npx tsx src/scripts/compareSceneImageValidation.ts",
    "compare:director": "cd services/api && npx tsx src/scripts/compareDirectorTextProviders.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/v1/billing/webhook/stripe",
    "migrate": "bash scripts/runMigration.sh",
    "dev": "pnpm --parallel dev",
    "dev:api": "pnpm --filter wondertales-api dev",
    "dev:app": "pnpm --filter wondertales-universal-app start",
    "dev:mobile": "pnpm --filter mobile dev",
    "dev:landing": "pnpm --filter web-landing dev",
    "build": "pnpm -r build",
    "launch:gate": "bash scripts/launch-gate.sh",
    "launch:scan-client-secrets": "bash scripts/scan-client-bundle-secrets.sh",
    "launch:check-security-headers": "bash scripts/check-security-headers.sh",
    "launch:check-production-security-artifacts": "node scripts/check-production-security-artifacts.js",
    "launch:check-production-smoke": "bash scripts/check-production-smoke.sh",
    "launch:check-production-smoke:full": "bash scripts/check-production-smoke.sh --full",
    "launch:check-production-ops": "bash scripts/check-production-ops.sh",
    "launch:check-production-ops:backup-smoke": "bash scripts/check-production-ops.sh --backup-smoke",
    "launch:monitor-production-ops": "bash scripts/monitor-production-ops.sh",
    "launch:run-production-backup-retention": "bash scripts/run-production-backup-retention.sh",
    "launch:run-offsite-restore-drill": "bash scripts/run-offsite-restore-drill.sh",
    "launch:configure-r2-rclone": "bash scripts/configure-r2-rclone.sh",
    "launch:install-production-ops-cron": "bash scripts/install-production-ops-cron.sh",
    "launch:check-production-admin-alerts": "bash scripts/check-production-admin-alerts.sh",
    "launch:check-paid-readiness": "bash scripts/check-paid-launch-readiness.sh",
    "launch:check-native-store-readiness": "node scripts/check-native-store-readiness.js",
    "launch:check-store-build-preflight": "node scripts/check-store-build-preflight.js",
    "launch:sync-revenuecat-catalog": "node scripts/sync-revenuecat-catalog.js",
    "launch:check-revenuecat-catalog": "node scripts/check-revenuecat-catalog.js",
    "test:revenuecat-catalog": "node scripts/test-revenuecat-catalog.js",
    "test": "node scripts/run-tests.mjs",
    "test:all": "node scripts/run-tests.mjs --all",
    "test:list": "node scripts/run-tests.mjs --list",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "android": "pnpm --filter wondertales-universal-app android",
    "ios": "pnpm --filter wondertales-universal-app ios"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "expo": "~54.0.33",
    "expo-crypto": "~15.0.8",
    "expo-font": "~14.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
