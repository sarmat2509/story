{
  "expo": {
    "name": "WonderTales",
    "slug": "wondertales",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wondertales",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0ea5e9"
    },
    "main": "index.js",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wondertales.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "wondertales",
              "com.wondertales.app",
              "com.googleusercontent.apps.151914486575-4ekba7gcqcbc6joqahhaigs7v97qjdoo"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.wondertales.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0ea5e9"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
