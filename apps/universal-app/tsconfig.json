{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      "@wondertales/shared": ["../../packages/shared/src"]
    },
    "jsx": "react-native"
  },
  "include": [
    "src/**/*",
    ".rnstorybook/**/*",
    "index.js",
    "*.ts",
    "*.tsx",
    "../../packages/shared/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js"
  ]
}
