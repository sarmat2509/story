# Environment
NODE_ENV=production
PORT=3000
API_VERSION=v1
API_BASE_URL=https://your-domain.com
EXPO_PUBLIC_API_BASE_URL=https://your-domain.com
WEB_APP_URL=https://wondertales.art
CORS_ALLOWED_ORIGINS=https://wondertales.art,https://www.wondertales.art

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wondertales_prod
POSTGRES_USER=wondertales
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=wondertales_prod

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d
SESSION_EXPIRES_IN=30d
CHILD_SESSION_EXPIRES_IN=8h
CHILD_SESSION_IDLE_TIMEOUT=2h
ENCRYPTION_KEY=64-character-hex-string-for-oauth-token-encryption

# Cloudflare Turnstile bot protection
# Create a widget in Cloudflare and set both public and server-side keys.
# Fill both keys before enabling CAPTCHA_REQUIRED_ACTIONS.
# Supported CAPTCHA_REQUIRED_ACTIONS: login,register,password_reset,feedback
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTCHA_REQUIRED_ACTIONS=
# CAPTCHA_REQUIRED_ACTIONS=register,password_reset,feedback

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://wondertales.art/api/v1/auth/google/callback
GOOGLE_IOS_CLIENT_ID=your-ios-client-id
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id

# Apple OAuth
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----
APPLE_CALLBACK_URL=https://wondertales.art/api/v1/auth/apple/callback

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
OPENAI_API_KEY=your-openai-api-key

# Google Cloud (for Image Generation & Quotas)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_CREDENTIALS=/path/to/service-account.json

# AI Configuration
AI_TEXT_VENDOR=gemini
# Optional: Director-only text vendor (see services/api/.env.example)
# AI_DIRECTOR_TEXT_VENDOR=openai
AI_IMAGE_VENDOR=gemini
AI_TTS_VENDOR=elevenlabs
AI_ALIGNMENT_VENDOR=elevenlabs
GEMINI_VISION_MODEL=gemini-2.5-flash
AI_MODEL_VERSION=gemini-3-flash-preview
GEMINI_VALIDATION_MODEL=gemini-3.1-flash-lite

# Image Generation
SKIP_IMAGE_GENERATION=false
IMAGE_PROVIDER=nanobananapro
# GEMINI_FLASH_IMAGE_MODEL=gemini-2.5-flash-image
# MAP_TILE_IMAGE_MODEL=gemini-2.5-flash-image
ENABLE_IMAGE_VALIDATION=false
# If true, failed validation gets one image-edit repair pass before best-of-2 selection.
IMAGE_VALIDATION_USE_EDIT_REPAIR=false
# Penalty applied when the validator's characterKind disagrees with the expected roster kind.
IMAGE_SCORE_PENALTY_KIND_MISMATCH=45
ENABLE_TURNAROUND_SHEET=false

# Storage (optional - for AWS S3)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_CDN_URL=

# RevenueCat native billing / catalog sync
# Secret key is server/ops-only. Never expose REVENUECAT_API_V2_SECRET_KEY to app bundles.
# REVENUECAT_API_V2_SECRET_KEY=sk_xxx
# REVENUECAT_PROJECT_ID=proj_xxx
# REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer generated-random-webhook-secret
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxx
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
# EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
# Optional if app auto-discovery is ambiguous:
# REVENUECAT_IOS_APP_ID=app_xxx
# REVENUECAT_ANDROID_APP_ID=app_xxx
# REVENUECAT_APP_IDS=app_ios,app_android
# Generated by: pnpm launch:sync-revenuecat-catalog -- --env-file=.env.production
# REVENUECAT_PRODUCT_PLAN_MAP=

# Orphan storage cleanup scheduler (safe defaults: disabled + dry-run)
ORPHAN_STORAGE_CLEANUP_ENABLED=false
ORPHAN_STORAGE_CLEANUP_APPLY=false
ORPHAN_STORAGE_CLEANUP_INTERVAL_MS=86400000
ORPHAN_STORAGE_CLEANUP_INITIAL_DELAY_MS=300000
ORPHAN_STORAGE_CLEANUP_MAX_DELETE=100
ORPHAN_STORAGE_CLEANUP_MIN_AGE_HOURS=168

# Feature Flags
ENABLE_CHARACTER_ANALYSIS=true

# Job Queue Concurrency
TEXT_QUEUE_CONCURRENCY=3
IMAGE_QUEUE_CONCURRENCY=10
AUDIO_QUEUE_CONCURRENCY=2
INSTANT_QUEUE_CONCURRENCY=3
