{
  "name": "wondertales",
  "version": "1.0.0",
  "private": true,
  "description": "Personalized illustrated fairy tales with AI-powered storytelling and premium narration",
  "author": "",
  "license": "ISC",
  "scripts": {
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:prod": "docker compose -f docker-compose.prod.yml up",
    "api:script": "docker compose -f docker-compose.dev.yml run --rm api",
    "dev": "pnpm --parallel dev",
    "dev:api": "pnpm --filter api dev",
    "dev:app": "pnpm --filter universal-app start",
    "dev:mobile": "pnpm --filter mobile dev",
    "dev:landing": "pnpm --filter web-landing dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native": "0.81.5",
      "iconv-lite": "^0.6.3"
    },
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-crypto": "~15.0.8",
    "expo-font": "~14.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
