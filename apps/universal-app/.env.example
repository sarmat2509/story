# ============================================
# WonderTales Universal App - Environment Variables
# ============================================
#
# Copy this file to .env and configure for your environment
#
# IMPORTANT: Environment variables are baked into the app bundle
# at build time. You MUST rebuild the app after changing this file.

# ============================================
# API Configuration
# ============================================

# Production Environment (Recommended)
# Connect via Nginx reverse proxy with proper rate limiting
EXPO_PUBLIC_API_BASE_URL=https://wondertales.art

# Alternative: Direct Container Access (bypasses Nginx)
# Use this only for special local development scenarios.
#
# Option 1: Use host.docker.internal (works on Mac/Windows with Docker Desktop)
# EXPO_PUBLIC_API_BASE_URL=http://host.docker.internal:3000
#
# Option 2: Use your Mac's local IP address
# Find it with: ipconfig getifaddr en0 (Mac) or ipconfig (Windows)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000
#
# Note: Direct access uses HTTP (not HTTPS) and bypasses Nginx rate limiting.

# ============================================
# OAuth Configuration
# ============================================

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=151914486575-4ekba7gcqcbc6joqahhaigs7v97qjdoo.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=151914486575-1kpc8ot6kdhjho9hbm7tbqmtgqv7tk60.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=151914486575-9tqc0a0ksjl6hhokoevcek809bkgve9r.apps.googleusercontent.com

# Apple OAuth
APPLE_CLIENT_ID=com.anonymous.wondertalesplus

# ============================================
# RevenueCat Native Billing
# ============================================

# Public RevenueCat SDK keys are safe in the app bundle, but still environment-specific.
# Configure matching offerings/packages in RevenueCat for plan slugs: silver, golden, fairyworld.
# Catalog can be generated/checked from repo root:
#   pnpm launch:sync-revenuecat-catalog -- --env-file=.env.production
#   pnpm launch:check-revenuecat-catalog -- --env-file=.env.production
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxx
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
# EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default

# ============================================
# Analytics (PostHog)
# ============================================
#
# Set EXPO_PUBLIC_ANALYTICS_VENDOR=posthog to enable. Requires EXPO_PUBLIC_POSTHOG_KEY.
# Expo loads .env from apps/universal-app/ (not from repo root).
#
# EXPO_PUBLIC_ANALYTICS_VENDOR=posthog
# EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ============================================
# Notes
# ============================================
#
# 1. Only variables prefixed with EXPO_PUBLIC_ are exposed to the app
# 2. After changing this file, rebuild the app:
#    npx expo run:ios --device
# 3. For local development:
#    - Use your Mac's local IP (NOT localhost or 127.0.0.1)
#    - Ensure iPad and Mac are on the same Wi-Fi network
#    - Start local API: pnpm dev:api (from project root)
# 4. For production:
#    - No local API needed
#    - App connects directly to production server
