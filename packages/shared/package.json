{
  "name": "@kazka/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, schemas, and utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:fast": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --external:zod --external:i18next --minify && tsc --emitDeclarationOnly --declaration",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.22.4",
    "i18next": "^23.7.16"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./i18n/*.json": "./src/i18n/*.json"
  }
}