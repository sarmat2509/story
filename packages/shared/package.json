{
  "name": "@wondertales/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, schemas, and utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && pnpm run copy:i18n",
    "build:fast": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --external:zod --external:i18next --minify && tsc --emitDeclarationOnly --declaration && pnpm run copy:i18n",
    "copy:i18n": "mkdir -p dist/i18n && cp src/i18n/*.json dist/i18n/",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.22.4",
    "i18next": "^23.7.16"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./i18n/uk.json": "./dist/i18n/uk.json",
    "./i18n/ru.json": "./dist/i18n/ru.json",
    "./i18n/en.json": "./dist/i18n/en.json",
    "./i18n/es.json": "./dist/i18n/es.json",
    "./i18n/fr.json": "./dist/i18n/fr.json",
    "./i18n/de.json": "./dist/i18n/de.json",
    "./i18n/pl.json": "./dist/i18n/pl.json"
  }
}
