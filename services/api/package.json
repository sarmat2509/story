{
  "name": "wondertales-api",
  "version": "1.0.0",
  "private": true,
  "description": "WonderTales API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "build:fast": "esbuild src/index.ts src/worker.ts src/scripts/scanOrphanStorageFiles.ts src/scripts/setOpsMode.ts src/scripts/waitForGenerationDrain.ts --bundle --platform=node --target=node20 --outdir=dist --outbase=src --external:@wondertales/shared --external:pg-native --external:sharp --external:fluent-ffmpeg --external:@aws-sdk/* --external:@google-cloud/* --external:@google/genai --external:openai --external:passport --external:passport-google-oauth20 --minify --log-level=warning --legal-comments=none",
    "start": "node dist/index.js",
    "start:worker": "RUN_HTTP_SERVER=false node dist/worker.js",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "postinstall": "bash scripts/install-ffmpeg.sh",
    "install:ffmpeg": "bash scripts/install-ffmpeg.sh",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/scripts/runMigration.ts",
    "db:migrate:m4-images": "npx tsx src/scripts/runMigration.ts 0005_add_m4_image_generation.sql",
    "db:migrate:metadata": "npx tsx src/scripts/runMigration.ts 0011_add_stories_metadata.sql",
    "db:migrate:audio": "npx tsx src/scripts/runMigration.ts 0012_add_stories_audio_metadata.sql",
    "db:migrate:intermediate": "npx tsx src/scripts/runMigration.ts 0013_add_story_request_intermediate_data.sql",
    "db:migrate:all": "pnpm exec tsx src/scripts/runAllMigrations.ts",
    "db:mark-migrations-applied": "npx tsx src/scripts/markExistingMigrationsAsApplied.ts",
    "seed:voices": "tsx src/scripts/seedVoices.ts",
    "seed:story-artifact-embeddings": "WT_SKIP_PROCESS_SIGNAL_HANDLERS=1 tsx src/scripts/seedStoryArtifactEmbeddings.ts",
    "generate:story-artifact-thumbnails": "tsx src/scripts/generateStoryArtifactThumbnails.ts",
    "generate:voice-samples": "tsx src/scripts/generateVoiceSamples.ts",
    "seed:test-accounts": "tsx src/scripts/seedQaTestAccounts.ts",
    "test:imagen": "npx tsx src/scripts/testImagenAPI.ts",
    "test:llm-character-persistence": "tsx src/services/__tests__/llmCharacterPersistence.test.ts",
    "test:cross-script-identity": "tsx src/utils/__tests__/crossScriptIdentityKey.test.ts",
    "test:character-outfits": "tsx src/utils/__tests__/characterOutfits.test.ts",
    "test:story-domain-text": "tsx src/domain/story/__tests__/storyDomainTextGeneration.test.ts",
    "test:story-domain-text-llm": "tsx src/domain/story/__tests__/storyDomainTextLlm.integration.ts",
    "db:migrate:closing-keepsake": "tsx src/scripts/runMigration.ts 0075_add_story_closing_keepsake_label.sql",
    "db:migrate:deactivate-grok-voices": "tsx src/scripts/runAllMigrations.ts 0076_deactivate_grok_tts_voices.sql",
    "db:migrate:audio-synthesis-tagged-text": "tsx src/scripts/runAllMigrations.ts 0077_add_audio_assets_synthesis_tagged_text.sql",
    "backfill:character-name-translations": "tsx src/scripts/backfillCharacterNameTranslations.ts",
    "backfill:ai-usage-costs": "tsx src/scripts/backfillAiUsageCosts.ts",
    "backfill:story-artifact-title-translations": "tsx src/scripts/backfillStoryArtifactTitleTranslations.ts",
    "writer:story": "WT_SKIP_PROCESS_SIGNAL_HANDLERS=1 tsx src/scripts/rerunWriterForStory.ts",
    "debug:story-artifact": "WT_SKIP_PROCESS_SIGNAL_HANDLERS=1 tsx src/scripts/debugStoryArtifactIntegration.ts",
    "print:writer-prompts": "tsx src/scripts/printWriterPromptSample.ts",
    "print:tts-prosody-llm-prompt": "tsx src/scripts/printTtsProsodyLlmPrompt.ts",
    "verify:defer-tts-prosody": "tsx src/scripts/verifyDeferredTtsProsody.ts",
    "prosody:story-deferred": "tsx src/scripts/runStoryDeferredProsody.ts",
    "verify:defer-tts-prosody-sample": "tsx src/scripts/verifyDeferredTtsProsody.ts -- --from-file=story-llm-generated-sample.txt",
    "verify:defer-tts-prosody-ru-scary": "WT_SKIP_PROCESS_SIGNAL_HANDLERS=1 tsx src/scripts/verifyDeferredTtsProsody.ts -- --from-file=story-ru-scary-sample.txt --language=ru --tagged-out=./defer-tts-ru-scary-tagged-output.txt",
    "defer-tts:tagged-to-audio": "tsx src/scripts/deferTaggedSamplesToTtsAudio.ts",
    "defer-tts:ru-scary-audio": "DEFER_TTS_LANGUAGE=ru DEFER_TTS_GOOGLE_VOICE=Charon tsx src/scripts/deferTaggedSamplesToTtsAudio.ts -- --from-file=defer-tts-ru-scary-tagged-output.txt --out=./defer-tts-ru-scary-audio-out --omit-google-style-prompt",
    "generate:ru-scary-story": "WT_SKIP_PROCESS_SIGNAL_HANDLERS=1 tsx src/scripts/generateRussianScaryStorySample.ts",
    "generate:seedream-reference-story": "WT_SKIP_PROCESS_SIGNAL_HANDLERS=1 tsx src/scripts/generateSeedreamReferenceStorySample.ts",
    "generate:seedream-existing-characters": "WT_SKIP_PROCESS_SIGNAL_HANDLERS=1 tsx src/scripts/generateSeedreamExistingCharactersSample.ts",
    "test:tts-prosody-tagged-text": "tsx src/utils/__tests__/ttsProsodyTaggedText.test.ts",
    "test:bundle-period-overlap": "tsx src/services/__tests__/bundlePeriodOverlap.test.ts",
    "test:outfit-plate-service": "tsx src/services/__tests__/outfitPlateService.test.ts",
    "compare:image-validation": "tsx src/scripts/compareSceneImageValidation.ts",
    "compare:director": "tsx src/scripts/compareDirectorTextProviders.ts",
    "prompt:artifact-lab": "tsx src/scripts/runArtifactImagePrompt.ts"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^6.5.0",
    "@google-cloud/storage": "^7.14.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/genai": "^2.9.0",
    "@wondertales/shared": "workspace:*",
    "any-ascii": "^0.3.3",
    "apple-signin-auth": "^1.7.6",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.29.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^7.1.0",
    "humps": "^2.0.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "marked": "^15.0.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.21.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "resend": "^4.0.0",
    "sharp": "^0.33.2",
    "stripe": "^17.4.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/humps": "^2.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "drizzle-kit": "^0.20.9",
    "esbuild": "^0.19.0",
    "pino-pretty": "^10.3.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
