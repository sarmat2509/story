# ============================================
# Kazka+ Universal App - Environment Variables
# ============================================
#
# Copy this file to .env and configure for your environment
#
# IMPORTANT: Environment variables are baked into the app bundle
# at build time. You MUST rebuild the app after changing this file.

# ============================================
# API Configuration
# ============================================

# Production Environment (Recommended)
# Use this to connect to the live production API
EXPO_PUBLIC_API_BASE_URL=https://magic-sleep-time.duckdns.org

# Local Development Environment
# Use this for backend development and testing
# Replace 192.168.1.100 with your Mac's local IP address
# Find it with: ipconfig getifaddr en0
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000

# ============================================
# OAuth Configuration
# ============================================

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=151914486575-4ekba7gcqcbc6joqahhaigs7v97qjdoo.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=151914486575-1kpc8ot6kdhjho9hbm7tbqmtgqv7tk60.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=151914486575-9tqc0a0ksjl6hhokoevcek809bkgve9r.apps.googleusercontent.com

# Apple OAuth
APPLE_CLIENT_ID=com.anonymous.kazkaplus

# ============================================
# Notes
# ============================================
#
# 1. Only variables prefixed with EXPO_PUBLIC_ are exposed to the app
# 2. After changing this file, rebuild the app:
#    npx expo run:ios --device
# 3. For local development:
#    - Use your Mac's local IP (NOT localhost or 127.0.0.1)
#    - Ensure iPad and Mac are on the same Wi-Fi network
#    - Start local API: pnpm dev:api (from project root)
# 4. For production:
#    - No local API needed
#    - App connects directly to production server
